generator client {
  provider = "prisma-client-js"
  output = "../prisma-generated/client"
}

generator json {
  provider = "prisma-json-types-generator"
  allowAny = false
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum TireBrand {
  CONTINENTAL
  IRIS
}

enum TireCategory {
  TOURISM
  UTILITY
  SUV
}

enum FaqCategory {
  ORDERS
  PAYMENT
  DELIVERY
  WARRANTY
}

enum OrderStatus {
  NEW
  PROCESSING
  COMPLETED
  CANCELLED
}

model AccountUser {
  id               String      @id @default(uuid()) @db.VarChar(72)
  fullName         String      @db.VarChar(255)
  username         String      @unique @db.VarChar(255)
  passwordHash     String      @db.VarChar(255)
  role             UserRole
  phoneNumber      String?     @db.VarChar(255)
  nationalIdNumber String?     @db.VarChar(255)
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  tireOrders       TireOrder[]
}

model AlgerianWilaya {
  id        String   @id @default(uuid()) @db.VarChar(72)
  code      String   @unique @db.VarChar(10)
  nameAr    String   @db.VarChar(255)
  /// ![Array<string>]
  communes  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TireStock {
  id             String       @id @default(uuid()) @db.VarChar(72)
  brand          TireBrand
  size           String       @db.VarChar(255)
  category       TireCategory
  priceDzd       Decimal      @db.Decimal(12, 2)
  availableStock Int          @default(0)
  reservedStock  Int          @default(0)
  minThreshold   Int          @default(0)
  speedIndex     String?      @db.VarChar(255)
  isAvailable    Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model PlatformFaq {
  id        String      @id @default(uuid()) @db.VarChar(72)
  question  String      @db.Text
  answer    String      @db.Text
  category  FaqCategory
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model SupportChannel {
  id          String   @id @default(uuid()) @db.VarChar(72)
  title       String   @db.VarChar(255)
  value       String   @db.VarChar(255)
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TireOrder {
  submissionKey String? @unique @db.VarChar(36)
  id                String       @id @default(uuid()) @db.VarChar(72)
  orderNumber       String       @unique @db.VarChar(64)
  customerName      String       @db.VarChar(255)
  phoneNumber       String       @db.VarChar(32)
  secondaryPhone    String       @db.VarChar(32)
  wilaya            String       @db.VarChar(255)
  commune           String       @db.VarChar(255)
  brand             TireBrand
  tireSize          String       @db.VarChar(255)
  quantity          Int
  unitPriceDzd      Decimal      @db.Decimal(12, 2)
  totalPriceDzd     Decimal      @db.Decimal(12, 2)
  nationalIdNumber  String       @db.VarChar(64)
  dahabiaCardNumber String       @db.VarChar(8)
  dahabiaExpiry     String       @db.VarChar(16)
  status            OrderStatus  @default(NEW)
  notes             String?      @db.Text
  customerId        String?      @db.VarChar(72) // FK → AccountUser.id
  customer          AccountUser? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([customerId])
}